# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=mysql+aiomysql://root:Root%4012345@192.168.15.121:3306/fits_dev_feb?allowPublicKeyRetrieval=true&useSSL=false

# Self-Hosted LLM Configuration (ENABLED)
# LLM_BASE_URL=http://192.168.15.121:8000/v1
# LLM_MODEL=/home/user/.cache/llmfit/models/Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
# LLM_API_KEY=dummy
LLM_TIMEOUT=20
LLM_MAX_RETRIES=0
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.2


# DATABASE_URL=mysql+aiomysql://root:12345@host.docker.internal:3306/remp-chat-bot
