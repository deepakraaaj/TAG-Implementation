# NL2SQL Assistant - environment example
# Copy to .env and fill values for the environment you are running.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
TRUST_PROXY_HEADERS=false
# Startup/domain context only. Chat routing is signed-token appcode driven.
DOMAIN=CHANGEME_STARTUP_DOMAIN
DEFAULT_CHAT_APP_ID=
APPS_CONFIG_PATH=./config/apps.local.yaml

# Required DB for Settings/startup only. Chat DB routing is token/app-config driven.
DATABASE_URL=mysql+aiomysql://CHANGEME_USER:CHANGEME_PASSWORD@127.0.0.1:3306/CHANGEME_STARTUP_DB_NAME?charset=utf8mb4

# Allowed widget origins. Use the S3/CDN or host-page origins for deployed environments.
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGIN_REGEX=

# Per-app DB URLs.
VTS_DATABASE_URL=postgresql+asyncpg://CHANGEME_USER:CHANGEME_PASSWORD@127.0.0.1:5432/CHANGEME_VTS_DB_NAME?search_path=vts_dms_sit
REMP_DATABASE_URL=mysql+aiomysql://CHANGEME_USER:CHANGEME_PASSWORD@127.0.0.1:3306/CHANGEME_REMP_DB_NAME?charset=utf8mb4
IMS_DATABASE_URL=mysql+aiomysql://CHANGEME_USER:CHANGEME_PASSWORD@127.0.0.1:3306/CHANGEME_IMS_DB_NAME?charset=utf8mb4

# Optional app DBs referenced by config/apps.remote.yaml. Leave blank unless used.
HZL_DATABASE_URL=
CROWD_DATABASE_URL=
FITS_DEV_HO_DATABASE_URL=
FITS_DEV_RAILWAY_DATABASE_URL=
IOC_DEV_MARCH_9_DATABASE_URL=

# Database TLS/SSL. Off = plaintext. Set true to encrypt DB connections.
# Do NOT put useSSL/sslMode in the URL (those JDBC params are stripped) -- use these.
DB_SSL_ENABLED=false
DB_SSL_VERIFY_CERT=false        # true + DB_SSL_CA for full server-cert verification
DB_SSL_CA=                      # path to CA .pem (only needed when verifying)

# JWT verification secrets. HMAC secrets are server-only.
VTS_JWT_SECRET=
FITS_JWT_SECRET=

# LLM provider
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=CHANGEME_LLM_API_KEY
LLM_TIMEOUT=30

# Redis / cache
REDIS_URL=redis://localhost:6384/0
CACHE_ENABLED=true

# Guardrails
RATE_LIMIT_PER_MINUTE=60
QUERY_TIMEOUT_SECONDS=30
SQL_STATEMENT_TIMEOUT_MS=30000
SQL_MAX_LIMIT=1000
MUTATION_REQUIRE_EXPLICIT_PERMISSION=true
ENABLE_AUDIT_LOGGING=false
# Demo-only kill switch for the narrow task-status write flow. FALSE = read-only.
ENABLE_TASK_STATUS_WRITE=false
SEMANTIC_RETRIEVAL_ENABLED=false
SEMANTIC_RETRIEVAL_AUTO_LEARN_ON_SUCCESS=false

# Admin dashboard
ADMIN_DASHBOARD_ENABLED=true
ADMIN_API_TOKEN=
