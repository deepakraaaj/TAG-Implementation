# ============================================================================
# TAG IMPLEMENTATION - ENVIRONMENT CONFIGURATION
# ============================================================================
# IMPORTANT: Docker reads this file via docker-compose.yml (env_file: - .env)
# Change domain here + rebuild Docker to switch between VTS/FITS/IMS
# See RUN.md for complete setup guide
# ============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
ASSISTANT_FLOW_MODE=yaml

# Admin dashboard (served at /dashboard/, API under /admin).
# Set a strong token to enable it; leave empty to disable the whole surface.
ADMIN_API_TOKEN=
ADMIN_DASHBOARD_ENABLED=true
ADMIN_TRACE_BUFFER_SIZE=200

# ============================================================================
# DOMAIN SELECTION (CRITICAL: Change this to switch domains)
# ============================================================================
# Options: vts | REMP | ims
DOMAIN=REMP
DEFAULT_CHAT_APP_ID=REMP
APPS_CONFIG_PATH=./config/apps.local.yaml

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Local Development (when running outside Docker)
# REMP runs on MySQL (database: REMPRecent); VTS runs on PostgreSQL.
REMP_DATABASE_URL=mysql+aiomysql://root:12345@localhost:3306/REMPRecent
VTS_DATABASE_URL=postgresql://postgres:password@localhost:5432/VTS
IMS_DATABASE_URL=mysql+aiomysql://username:password@localhost:3306/IMS

# Docker Development (when running inside Docker containers)
# NOTE: Use host.docker.internal to access host's MySQL from container
DATABASE_URL_DOCKER=mysql+aiomysql://root:12345@host.docker.internal:3306/REMPRecent?allowPublicKeyRetrieval=true&useSSL=false
REMP_DATABASE_URL_DOCKER=mysql+aiomysql://root:12345@host.docker.internal:3306/REMPRecent?allowPublicKeyRetrieval=true&useSSL=false
VTS_DATABASE_URL_DOCKER=postgresql://postgres:password@host.docker.internal:5432/VTS
IMS_DATABASE_URL_DOCKER=mysql+aiomysql://username:password@host.docker.internal:3306/IMS?allowPublicKeyRetrieval=true&useSSL=false

# ============================================================================
# DOCKER PORTS
# ============================================================================
TAG_BACKEND_PORT=8012
CHATBOT_DEMO_PORT=5174
REDIS_HOST_PORT=6384

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
# For Docker (Ollama running on host)
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
# For local development
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key-here

# LLM Retry Configuration
LLM_TIMEOUT=20
LLM_MAX_RETRIES=0
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.2

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Local development
REDIS_URL=redis://localhost:6384/0
# Docker (backend connects to redis service)
# REDIS_URL=redis://redis:6379/0

# ============================================================================
# SEMANTIC RETRIEVAL (Optional)
# ============================================================================
SEMANTIC_RETRIEVAL_ENABLED=false
SEMANTIC_RETRIEVAL_PROVIDER=fastembed
SEMANTIC_RETRIEVAL_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_RETRIEVAL_TOP_K=6
SEMANTIC_RETRIEVAL_PROMPT_K=6
SEMANTIC_RETRIEVAL_MIN_SCORE=0.35
SEMANTIC_RETRIEVAL_ROUTE_MIN_SCORE=0.45

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# ============================================================================
# HOW TO USE THIS FILE
# ============================================================================
# 1. For VTS Demo:
#    DOMAIN=vts
#    DEFAULT_CHAT_APP_ID=vts
#    Rebuild: docker-compose down && docker-compose up --build -d
#
# 2. For REMP Demo (Recommended):
#    DOMAIN=REMP
#    DEFAULT_CHAT_APP_ID=REMP
#    Rebuild: docker-compose down && docker-compose up --build -d
#
# 3. For IMS Demo:
#    DOMAIN=ims
#    DEFAULT_CHAT_APP_ID=ims
#    Rebuild: docker-compose down && docker-compose up --build -d
#
# See RUN.md for detailed instructions
# ============================================================================
