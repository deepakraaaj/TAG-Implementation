# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=mysql+aiomysql://debian-sys-maint:password@localhost:3306/VTS?unix_socket=/var/run/mysqld/mysqld.sock
APPS_CONFIG_PATH=./config/apps.local.yaml
DEFAULT_CHAT_APP_ID=vts

# Container-safe DB URLs for `docker compose up`
DATABASE_URL_DOCKER=mysql+aiomysql://username:password@host.docker.internal:3306/fits_dev_march_9?allowPublicKeyRetrieval=true&useSSL=false
FITS_DATABASE_URL_DOCKER=mysql+aiomysql://username:password@host.docker.internal:3306/fits_dev_march_9?allowPublicKeyRetrieval=true&useSSL=false
VTS_DATABASE_URL_DOCKER=mysql+aiomysql://username:password@host.docker.internal:3306/VTS?allowPublicKeyRetrieval=true&useSSL=false
IMS_DATABASE_URL_DOCKER=mysql+aiomysql://username:password@host.docker.internal:3306/IMS?allowPublicKeyRetrieval=true&useSSL=false

# Optional host ports for docker compose
TAG_BACKEND_PORT=8012
CHATBOT_DEMO_PORT=5174
REDIS_HOST_PORT=6384

# Self-Hosted LLM Configuration (ENABLED)
# LLM_BASE_URL=http://192.168.15.112:8000/v1
# LLM_MODEL=/home/user/.cache/llmfit/models/Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
# LLM_API_KEY=dummy
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
LLM_TIMEOUT=20
LLM_MAX_RETRIES=0
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_BACKOFF_SECONDS=0.2

# Groq LLM Configuration (DISABLED)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key-here

# Legacy compatibility (optional)
GROQ_API_KEY=dummy-key-for-local-llm

# OpenAI for embeddings (if needed, otherwise can use local embeddings)
# OPENAI_API_KEY=your-openai-key-here

# Optional semantic retrieval over domain artifacts
SEMANTIC_RETRIEVAL_ENABLED=false
SEMANTIC_RETRIEVAL_PROVIDER=fastembed
SEMANTIC_RETRIEVAL_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_RETRIEVAL_TOP_K=6
SEMANTIC_RETRIEVAL_PROMPT_K=6
SEMANTIC_RETRIEVAL_MIN_SCORE=0.35
SEMANTIC_RETRIEVAL_ROUTE_MIN_SCORE=0.45



# Redis Configuration
REDIS_URL=redis://localhost:6384/0

# Guided flow mode: mutation | hybrid | yaml
ASSISTANT_FLOW_MODE=yaml

# Domain Configuration
# Specify which domain/application to load (vts, ims, fits_dev_march_9, etc.)
DOMAIN=vts
